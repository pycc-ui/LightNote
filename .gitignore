#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# /build/ 只匹配仓库**根目录**的那个 —— Gradle 在 android/ 下也会生成一个
# （里面有 reports/problems 这类 HTML），不写这条就会被 git add -A 顺手带进版本库。
android/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# 本项目自己加的
# ---------------------------------------------------------------------------

# Windows 插件符号链接目录。
# Flutter 构建时会在这里为每个插件建链接，属于生成物；
# 而且 tarball/zip 里符号链接容易被解成普通文件，提交进去会脏。
/windows/flutter/ephemeral/.plugin_symlinks/

# 一键验证脚本的临时产物（测试用数据库、运行日志）
/logs/

# App 启动时写给构建脚本看的"数据库位置"报告。
# 它在 exe 所在目录（build\ 下面），是运行期产物，不该进版本库。
.lightnote-storage.txt


# 开发用的 API Key 文件（绝不要提交）
.lightnote-apikey.txt

# ---------------------------------------------------------------------------
# Android 发布签名（绝不要提交）
#
# key.properties 里是 keystore 路径与两个密码；.jks/.keystore 是私钥本体。
# 一旦进了版本库，任何人都能用它签出"你的"安装包 —— 而这在开源仓库里
# 是**永久泄露**（改密码没用，得换密钥，也就意味着老用户必须卸载重装）。
# ---------------------------------------------------------------------------
/android/key.properties
*.jks
*.keystore


# Python 生成物（缓存目录）
__pycache__/

